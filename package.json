{
  "name": "novel-gen-suite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server/static.ts",
    "dev": "vite --config src/web/vite.config.ts",
    "build": "vite build --config src/web/vite.config.ts",
    "test": "tsx --test 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "e2e": "playwright test",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit --jsx react-jsx"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "hono": "^4.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
